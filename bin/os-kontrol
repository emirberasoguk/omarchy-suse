def sema_rengi(anahtar: str, yedek: str) -> str:
    try:
        d = json.loads((Path.home() / ".local/state/caelestia/scheme.json").read_text())
        v = d.get("colours", d).get(anahtar)
        if isinstance(v, str) and len(v.lstrip("#")) == 6:
            return "#" + v.lstrip("#")
    except Exception:
        pass
    return yedek


