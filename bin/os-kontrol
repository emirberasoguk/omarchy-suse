# Kendi ikonumuz yazılamazsa düşülecek Adwaita adları.
YEDEK_ADLAR = {
    "ocr": "scanner-symbolic",
    "qr": "view-grid-symbolic",
    "gece-acik": "night-light-symbolic",
    "gece-kapali": "night-light-disabled-symbolic",
    "pano": "edit-paste-symbolic",
    "paylas": "send-to-symbolic",
    "dosya-paylas": "document-send-symbolic",
    "ekran": "video-display-symbolic",
    "gpu": "application-x-executable-symbolic",
    "hotspot-acik": "network-wireless-symbolic",
    "hotspot-kapali": "network-wireless-offline-symbolic",
    "cikis": "application-exit-symbolic",
}


def sembol(anahtar: str) -> str:
    """Üretilmiş ikonun adı; dosya yoksa Adwaita adına düşer."""
    hedef = HICOLOR / f"os-kontrol-s-{anahtar}.svg"
    return f"os-kontrol-s-{anahtar}" if hedef.exists() else YEDEK_ADLAR[anahtar]


def sembolleri_uret(renk: str) -> list[str]:
    """Menü ikonlarını şema rengiyle üret. Artık kopyalamıyoruz, çiziyoruz.

    Dönen liste: İLK KEZ oluşturulan ikonlar. Qt ikon temasını süreç
    başlarken önbelleğe aldığı için, kabuk zaten koşarken eklenen bir ikon
    yeniden başlatılana kadar görünmez — çağıran bunu haber verebilsin diye.
    """
    HICOLOR.mkdir(parents=True, exist_ok=True)
    yeni: list[str] = []
    for anahtar, ic in SEMBOLLER.items():
        hedef = HICOLOR / f"os-kontrol-s-{anahtar}.svg"
        vardi = hedef.exists()
        try:
            hedef.write_text(CIZGI.format(r=renk, ic=ic.replace("{r}", renk)))
        except OSError:
            continue
        if not vardi:
            yeni.append(anahtar)
    return yeni


def ikonlari_uret() -> list[str]:
    """Tepsi ikonlarını şema rengiyle üret. Her açılışta yenilenir.

    İki yere birden yazıyoruz:
      - IKON_DIZIN → SNI'nin IconThemePath'i
      - hicolor/scalable/apps → asıl çözülen yer

    Neden ikisi: caelestia'nın getTrayIcon'u önce Quickshell.iconPath() ile
    TEMA araması yapıyor; bulamazsa "<path>/<ad>" diye deniyor ama uzantı
    eklemiyor, yani o yedek hiç tutmuyor. Bu yüzden ikonun gerçekten tema
    içinde (hicolor) olması şart.
    """
    # Bar'ın durum ikonları m3secondary kullanıyor (StatusIcons.qml:15) —
    # tepsi ikonu da aynı rengi kullansın ki tek dil olsun.
    renk = sema_rengi("secondary", "#d0c7a2")
    acik_svg, kapali_svg = IKON_SETLERI[IKON_SETI]
    for dizin in (IKON_DIZIN, HICOLOR):
        dizin.mkdir(parents=True, exist_ok=True)
        (dizin / f"{IKON_ACIK}.svg").write_text(acik_svg.format(r=renk))
        (dizin / f"{IKON_KAPALI}.svg").write_text(kapali_svg.format(r=renk))
    yeni = sembolleri_uret(renk)
    try:
        subprocess.run(["gtk-update-icon-cache", "-qtf", str(HICOLOR.parents[1])],
                       capture_output=True, timeout=10)
    except (subprocess.SubprocessError, OSError):
        pass
    return yeni


# ── Sistem durumu okuma ───────────────────────────────────────────
def kabuk(*komut: str, timeout: float = 4.0) -> str:
    try:
        r = subprocess.run(komut, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def calistir(*komut: str) -> None:
    """Menüden tetiklenen işler arka planda, oturumdan bağımsız koşsun."""
    try:
        subprocess.Popen(komut, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def gece_acik() -> bool:
    return bool(kabuk("pgrep", "-x", "hyprsunset"))


def kayit_suruyor() -> bool:
    return bool(kabuk("pgrep", "-x", "gpu-screen-recorder"))


def hypr_secenek(ad: str, alan: str = "float") -> str:
    ham = kabuk("hyprctl", "getoption", ad, "-j")
    try:
        return str(json.loads(ham).get(alan, ""))
    except (json.JSONDecodeError, AttributeError):
        return ""


def seffaflik_acik() -> bool:
    return hypr_secenek("decoration:active_opacity") not in ("1.000000", "1.0", "1", "")


def bosluk_acik() -> bool:
    css = hypr_secenek("general:gaps_out", "css")
    return css.split()[0] != "0" if css else True


def ekran() -> dict:
    """Tazeleme hızı ayarlanacak monitör: dahili panel (eDP*) varsa o,
    yoksa odaktaki monitör. Hiç monitör okunamazsa boş sözlük."""
    try:
        m = json.loads(kabuk("hyprctl", "monitors", "-j"))
    except json.JSONDecodeError:
        return {}
    if not isinstance(m, list) or not m:
        return {}
    return (next((x for x in m if str(x.get("name", "")).startswith("eDP")), None)
            or next((x for x in m if x.get("focused")), m[0]))


def tazeleme() -> int:
    try:
        return round(float(ekran()["refreshRate"]))
    except (KeyError, TypeError, ValueError):
        return 0


def tazeleme_secenekleri() -> list[int]:
    """Monitörün ŞU ANKİ çözünürlükte desteklediği tazeleme hızları.
    Sabit 144/60 yazmak yerine donanımın kendi listesinden okunuyor
    (availableModes: "1920x1080@144.00Hz" biçiminde)."""
    e = ekran()
    on_ek = f'{e.get("width")}x{e.get("height")}@'
    hizlar = set()
    for mod in e.get("availableModes", []):
        if isinstance(mod, str) and mod.startswith(on_ek):
            try:
                hizlar.add(round(float(mod[len(on_ek):].removesuffix("Hz"))))
            except ValueError:
                pass
    return sorted(hizlar, reverse=True)


def gpu_modu() -> tuple[str, str]:
    """(aktif, bekleyen) — supergfxctl yoksa boş döner."""
    if not shutil.which("supergfxctl"):
        return ("", "")
    aktif = kabuk("supergfxctl", "-g")
    bekleyen = kabuk("supergfxctl", "-P")
    if bekleyen in ("Unknown", aktif):
        bekleyen = ""
    return (aktif, bekleyen)


def hotspot() -> tuple[bool, str]:
    """(açık mı, SSID) — hotspotd'nin durum dosyası root'a kapalı (/run/hotspotd
    0700), o yüzden `iw dev`e bakıyoruz: type AP olan arayüz varsa hotspot
    ayakta ve SSID de orada. iw kullanıcıya açık, root gerekmiyor."""
    iface_ssid = ""
    for satir in kabuk("/usr/sbin/iw", "dev").splitlines():
        p = satir.strip()
        if p.startswith("ssid "):
            iface_ssid = p[5:]
        elif p == "type AP":
            return (True, iface_ssid)
        elif p.startswith("Interface "):
            iface_ssid = ""
    return (False, "")


# hotspotd'yi kaynaktan geliştiriyorsan HOTSPOTD_KAYNAK ile ağacın yolunu ver;
# kurulu sürüm geride kalınca menüye "Güncelle" maddesi çıkar.
_HS_KOK = os.environ.get("HOTSPOTD_KAYNAK", "")
HOTSPOTD_KAYNAK = Path(_HS_KOK).expanduser() / "hotspotd/__init__.py" if _HS_KOK else None


def hotspotd_surumler() -> tuple[str, str]:
    """(kurulu, kaynaktaki) — hotspotd geliştirilen bir proje, sistemdeki kopya
    kaynak ağacın gerisinde kalabiliyor. Menü bunu görünce güncelleme maddesi
    çıkarıyor. Yalnız menü YENİDEN KURULURKEN okunuyor (3 sn'lik nabızda değil):
    `hotspotd --version` bir python süreci başlatıyor."""
    kurulu = kabuk("hotspotd", "--version").split()[-1:] or [""]
    try:
        kaynak = next(
            satir.split('"')[1]
            for satir in (HOTSPOTD_KAYNAK.read_text() if HOTSPOTD_KAYNAK else "").splitlines()
            if satir.startswith("__version__")
        )
    except (OSError, StopIteration, IndexError):
        kaynak = ""
    return (kurulu[0], kaynak)


def wifi_band() -> str:
    c = kabuk("nmcli", "-t", "-f", "NAME,TYPE", "con", "show", "--active")
    ad = next((s.split(":")[0] for s in c.splitlines() if ":802-11-wireless" in s), "")
    if not ad:
        return ""
    b = kabuk("nmcli", "-g", "802-11-wireless.band", "con", "show", ad)
    return {"bg": "2.4 GHz", "a": "5 GHz", "6GHz": "6 GHz", "": "otomatik"}.get(b, b)


# ── Menü ──────────────────────────────────────────────────────────
class Kontrol:
    def __init__(self) -> None:
        yeni_ikonlar = ikonlari_uret()
        # Kabuk zaten koşuyorken yeni bir ikon eklendiyse Qt onu göremez
        # (ikon teması süreç başlarken önbelleğe alınıyor) ve menüde ikon
        # yerine boşluk çıkar. Sessiz kalmasın: söyle.
        if yeni_ikonlar and kabuk("pgrep", "-f", "qs -c caelestia"):
            calistir("notify-send", "-a", "Kontrol", "Yeni menü ikonu",
                     f"{len(yeni_ikonlar)} ikon eklendi — caelestia yeniden "
                     "başlayınca görünecek:  caelestia shell -k && caelestia shell -d")
        self.ind = AppIndicator.Indicator.new(
            "os-kontrol", IKON_KAPALI,
            AppIndicator.IndicatorCategory.SYSTEM_SERVICES)
        self.ind.set_icon_theme_path(str(IKON_DIZIN))
        self.ind.set_title("Kontrol")
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.menu = Gtk.Menu()
        self.ind.set_menu(self.menu)
        # Sol tık da menüyü açsın (kullanıcı tercihi)
        self.ind.set_secondary_activate_target(None)

        # DBusMenu'de menü YEREL olarak hiç gösterilmiyor — tüketici (Quickshell)
        # AboutToShow çağırıyor ve bu GTK'nin "show" sinyalini tetiklemiyor.
        # Bu yüzden "show"a bağlanmak işe yaramıyordu: etiketler ve ikonlar ilk
        # kurulumdaki değerlerde donuyordu. Durumu yoklayıp değiştiğinde
        # yeniden kuruyoruz.
        self._imza = None
        self.kur()
        GLib.timeout_add_seconds(3, self.nabiz)

    # -- yardımcılar --
    def _ekle(self, etiket: str, geri=None, ikon: str | None = None) -> Gtk.MenuItem:
        oge = Gtk.ImageMenuItem.new_with_label(etiket) if ikon else Gtk.MenuItem.new_with_label(etiket)
        if ikon:
            oge.set_image(Gtk.Image.new_from_icon_name(ikon, Gtk.IconSize.MENU))
            oge.set_always_show_image(True)
        if geri:
            oge.connect("activate", lambda *_: geri())
        else:
            oge.set_sensitive(False)
        self.menu.append(oge)
        return oge

    def _ayrac(self) -> None:
        self.menu.append(Gtk.SeparatorMenuItem())

    def _altmenu(self, etiket: str, ogeler: list[tuple[str, object]],
                 ikon: str | None = None) -> None:
        ust = Gtk.ImageMenuItem.new_with_label(etiket) if ikon else Gtk.MenuItem.new_with_label(etiket)
        if ikon:
            ust.set_image(Gtk.Image.new_from_icon_name(ikon, Gtk.IconSize.MENU))
            ust.set_always_show_image(True)
        alt = Gtk.Menu()
        for ad, geri in ogeler:
            o = Gtk.MenuItem.new_with_label(ad)
            if geri:
                o.connect("activate", lambda _w, g=geri: g())
            else:
                o.set_sensitive(False)
            alt.append(o)
        ust.set_submenu(alt)
        self.menu.append(ust)

    # -- menüyü kur --
    def kur(self) -> None:
        for c in self.menu.get_children():
            self.menu.remove(c)

        # En sık kullanılanlar en üstte — kullanıcı bunlar için tepsiyi istedi
        self._ekle("Ekrandan metin oku  (OCR)",
                   lambda: calistir(str(BIN / "os-yakala"), "ocr"), sembol("ocr"))
        self._ekle("QR kodu oku",
                   lambda: calistir(str(BIN / "os-yakala"), "qr"), sembol("qr"))
        self._ayrac()

        # CheckMenuItem ikon taşımıyor (tasarımı gereği onay kutusu gösteriyor),
        # o yüzden durumu ikonun kendisiyle anlatıyoruz.
        gece = gece_acik()
        self._ekle("Gece ışığı  ·  açık" if gece else "Gece ışığı  ·  kapalı",
                   lambda: self.gecikmeli(str(BIN / "os-gece")),
                   sembol("gece-acik") if gece else sembol("gece-kapali"))
        self._ayrac()
        self._ekle("Panoyu dosyaya kaydet",
                   lambda: calistir(str(BIN / "os-pano-kaydet")), sembol("pano"))
        self._ekle("Panoyu paylaş",
                   lambda: calistir(str(BIN / "os-paylas"), "pano"), sembol("paylas"))
        self._ekle("Dosya paylaş",
                   lambda: calistir(str(BIN / "os-paylas"), "dosya"), sembol("dosya-paylas"))

        self._ayrac()
        hs_acik, hs_ssid = hotspot()
        hs_kurulu, hs_kaynak = hotspotd_surumler()
        if hs_kurulu:
            hs_ogeler = [
                ("Kapat" if hs_acik else "Aç",
                 lambda: calistir(str(BIN / "os-hotspot"), "degistir")),
                ("Ayarlar ve tanılama…",
                 lambda: calistir(*TERMINAL, str(BIN / "os-hotspot"))),
            ]
            if hs_kaynak and hs_kaynak != hs_kurulu:
                hs_ogeler.append((f"Güncelle  ·  {hs_kurulu} → {hs_kaynak}",
                                  lambda: calistir(*TERMINAL, str(BIN / "os-hotspot"),
                                                   "guncelle")))
            hs_etiket = f"Hotspot  ·  {hs_ssid or 'açık'}" if hs_acik else "Hotspot  ·  kapalı"
        else:
            hs_ogeler = [("hotspotd'yi kur…",
                          lambda: calistir(*TERMINAL, str(BIN / "os-hotspot")))]
            hs_etiket = "Hotspot  ·  kurulu değil"
        self._altmenu(hs_etiket, hs_ogeler,
                      sembol("hotspot-acik" if hs_acik else "hotspot-kapali"))

        self._ayrac()
        hz = tazeleme()
        secenekler = tazeleme_secenekleri()
        if len(secenekler) > 1:
            self._altmenu(f"Ekran  ·  {hz} Hz" if hz else "Ekran",
                          [(f"{s} Hz", lambda s=s: self.mod_ayarla(s)) for s in secenekler],
                          sembol("ekran"))

        aktif, bekleyen = gpu_modu()
        if aktif:
            etiket = f"GPU  ·  {aktif}" + (f"  →  {bekleyen} (çıkış gerekli)" if bekleyen else "")
            self._altmenu(etiket, [
                ("Hybrid  (NVIDIA açık)", lambda: self.gpu_ayarla("Hybrid")),
                ("Integrated  (pil dostu; dGPU'ya bağlı portlar çalışmaz)", lambda: self.gpu_ayarla("Integrated")),
                ("— çıkış yaptığında uygulanır —", None),
            ], sembol("gpu"))

        self._ayrac()
        self._ekle("Kontrolü kapat", Gtk.main_quit, sembol("cikis"))

        self.menu.show_all()
        self._imza = self.durum_imzasi()
        self.ikon_yenile()

    # -- eylemler --
    def gecikmeli(self, *komut: str) -> None:
        """Komutu çalıştır, sonra durumların oturması için ikonu yenile."""
        calistir(*komut)
        # Eylem oturana kadar bekle, sonra menüyü tazele
        GLib.timeout_add(900, lambda: (self.kur(), False)[1])

    def mod_ayarla(self, hz: int) -> None:
        # Konum ve ölçek monitörün o anki değerlerinden korunuyor; "auto"
        # yazmak çok monitörlü düzeni yeniden dizip bozabilirdi.
        e = ekran()
        if not e:
            return
        calistir("hyprctl", "eval",
                 f'hl.monitor({{ output = "{e["name"]}", '
                 f'mode = "{e["width"]}x{e["height"]}@{hz}", '
                 f'position = "{e.get("x", 0)}x{e.get("y", 0)}", '
                 f'scale = {e.get("scale", 1)} }})')

    def gpu_ayarla(self, mod: str) -> None:
        calistir("supergfxctl", "-m", mod)

    def durum_imzasi(self) -> tuple:
        """Menüde görünen her şeyin özeti — değişince menü yeniden kurulur."""
        return (gece_acik(), tazeleme(), gpu_modu(), hotspot())

    def nabiz(self) -> bool:
        imza = self.durum_imzasi()
        if imza != self._imza:
            self.kur()
        else:
            self.ikon_yenile()
        return True

    def ikon_yenile(self) -> bool:
        self.ind.set_icon_full(IKON_ACIK if gece_acik() else IKON_KAPALI, "Kontrol")
        return True


def main() -> None:
    # --ikonlar: yalnızca ikonları üret ve çık.
    # Qt ikon temasını SÜREÇ BAŞLARKEN önbelleğe alıyor; kabuk başladıktan
    # sonra hicolor'a eklenen dosyaları görmüyor (kırık kare çiziyor).
    # Bu yüzden baslat-caelestia.sh kabuğu başlatmadan ÖNCE bunu çağırıyor.
    if "--ikonlar" in sys.argv:
        yeni = ikonlari_uret()
        print(f"ikonlar üretildi: {HICOLOR}")
        if yeni:
            print("ilk kez oluşturulanlar: " + ", ".join(yeni))
        return

    os.environ.setdefault("GDK_BACKEND", "wayland,x11")
    Kontrol()
    Gtk.main()


if __name__ == "__main__":
    main()
