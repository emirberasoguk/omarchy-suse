#!/bin/bash
# Gece modu (mavi ışık azaltma) — hyprsunset ile.
set -uo pipefail

# notify-send yoksa sessizce geç (libnotify-tools kurulu olmayabilir)
bildir() { command -v notify-send >/dev/null 2>&1 && notify-send "$@" >/dev/null 2>&1; return 0; }
SICAKLIK="${OS_GECE_SICAKLIK:-4000}"
if pgrep -x hyprsunset >/dev/null 2>&1; then
    pkill -x hyprsunset
    bildir -a "Gece modu" "Kapatıldı" 2>/dev/null
else
    command -v hyprsunset >/dev/null || { bildir -a "Gece modu" "hyprsunset kurulu değil" 2>/dev/null; exit 1; }
    hyprsunset -t "$SICAKLIK" >/dev/null 2>&1 &
    bildir -a "Gece modu" "Açıldı (${SICAKLIK}K)" 2>/dev/null
fi
